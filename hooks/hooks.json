{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/update-check.mjs\"",
            "timeout": 5,
            "statusMessage": "mr-brief: checking for a newer version (once a day)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/offer.mjs\"",
            "timeout": 10,
            "statusMessage": "mr-brief: is this an MR being opened?"
          }
        ]
      }
    ]
  }
}
